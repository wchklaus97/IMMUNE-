    "create:native-smoke-evidence": "node tools/create_native_smoke_evidence.mjs",
    "create:playtest-kit": "node tools/create_human_playtest_kit.mjs",
    "create:playtest-campaign": "node tools/create_human_playtest_campaign.mjs",
    "run:playtest-session": "node tools/run_human_playtest_session.mjs",
    "aggregate:playtests": "node tools/aggregate_human_playtests.mjs",
    "validate:playtest-template": "node tools/validate_human_playtest.mjs docs/playtesting/six-family-playtest-template.json --allow-incomplete",
