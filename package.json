{
  "name": "immune-permanent-research-network",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:tools": "node --test tools/*.test.mjs",
    "test:web-release": "node tools/web_release_qa.mjs",
    "validate:steam-assets": "node tools/validate_steam_assets.mjs",
    "validate:steam-readiness": "node tools/validate_steam_readiness.mjs",
    "validate:gpu-regression": "node tools/validate_gpu_regression.mjs",
    "run:gpu-abba": "node tools/run_v8_6_gpu_abba.mjs",
    "validate:v8-5-export": "node tools/validate_v8_5_export.mjs",
    "validate:v8-6-export": "node tools/validate_v8_6_export.mjs",
    "validate:v8-6-animations": "node tools/validate_v8_6_animations.mjs",
    "validate:release-audio": "node tools/generate_release_audio.mjs --check",
    "generate:release-audio": "node tools/generate_release_audio.mjs --write",
    "prepare:steam": "node tools/prepare_steam_build.mjs",
    "create:native-smoke-evidence": "node tools/create_native_smoke_evidence.mjs",
    "create:playtest-kit": "node tools/create_human_playtest_kit.mjs",
    "create:playtest-campaign": "node tools/create_human_playtest_campaign.mjs",
    "create:visual-preference-campaign": "node tools/create_visual_preference_campaign.mjs",
    "run:playtest-session": "node tools/run_human_playtest_session.mjs",
    "aggregate:playtests": "node tools/aggregate_human_playtests.mjs",
    "validate:playtest-template": "node tools/validate_human_playtest.mjs docs/playtesting/six-family-playtest-template.json --allow-incomplete",
    "serve": "node tools/serve.mjs",
    "capture": "node tools/capture-ux.mjs",
    "capture:cover": "node tools/capture-cover.mjs",
    "docs": "node tools/capture-ux.mjs && node tools/bake-docs.mjs",
