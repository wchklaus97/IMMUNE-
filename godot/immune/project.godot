; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="IMMUNE"
config/description="3D immune-cell tower defense plus the permanent research-network HUD."
config/version="0.4.0"
config/icon="res://ui_icons/symbols/SYM-CORE.png"
run/main_scene="res://ui/research/research_network.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Catalog="*res://autoload/catalog.gd"
ResearchState="*res://autoload/research_state.gd"
SettingsState="*res://autoload/settings_state.gd"
AudioDirector="*res://autoload/audio_director.gd"
VfxLibrary="*res://autoload/vfx_library.gd"
WebQaBridge="*res://autoload/web_qa_bridge.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://fonts/NotoSansHK-VF.ttf"

[internationalization]

locale/translations=PackedStringArray("res://translations/game.zh_HK.translation", "res://translations/game.en.translation", "res://translations/research_catalog.zh_HK.translation", "res://translations/research_catalog.en.translation")

[immune]

visual/gel_look="v8_2"

